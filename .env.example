# ConnectGHIN mobile — copy to `.env`, edit values, then sync into the app:
#   tool\sync_env_to_asset.cmd
# That writes lib/generated/app_env.dart (avoids Windows file-lock on bundled assets).
#
# Optional override on run: flutter run --dart-define=KEY=value
# Resolution order: --dart-define → lib/generated/app_env.dart → code defaults
#
# ─── Required for production / LDPlayer / device testing ───────────────────

# REST API (include /api/v1). Socket.IO chat URL is derived from this host.
API_BASE_URL=https://api.connectghin.com/api/v1

# Google Sign-In: OAuth **Web** client ID (same as backend GOOGLE_OAUTH_CLIENT_ID).
GOOGLE_SERVER_CLIENT_ID=

# ─── Optional ───────────────────────────────────────────────────────────────

# Onboarding address autocomplete only (Places API). Not used for GPS / GHINder.
GOOGLE_PLACES_API_KEY=

# ─── Not configured via .env (for reference) ────────────────────────────────
# Push (FCM): android/app/google-services.json + lib/firebase_options.dart
# Backend push: connectghin-server FIREBASE_SERVICE_ACCOUNT_JSON
# In-app purchases: Play Billing (no Stripe key in mobile app)

# ─── Local backend examples (uncomment one API_BASE_URL) ─────────────────────
# Android emulator → PC:     API_BASE_URL=http://10.0.2.2:3001/api/v1
# adb reverse to localhost:  API_BASE_URL=http://127.0.0.1:3001/api/v1
# Physical device on LAN:    API_BASE_URL=http://192.168.1.10:3001/api/v1
