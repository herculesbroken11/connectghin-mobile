# Copy to .env, then run: powershell -File tool/sync_env_to_asset.ps1
# (writes assets/env/config.env for the Flutter app — gitignored)
# Android emulator -> host machine:
API_BASE_URL=http://10.0.2.2:3001/api/v1

# Google Sign-In web client ID (same as backend GOOGLE_OAUTH_CLIENT_ID).
GOOGLE_SERVER_CLIENT_ID=

# Optional: address autocomplete in onboarding only (NOT required for GPS / GHINder).
# Enable Places API in Google Cloud, restrict key to Places + your app.
GOOGLE_PLACES_API_KEY=

# iOS simulator/desktop:
# API_BASE_URL=http://localhost:3000/api/v1

# Physical device (replace with your LAN IP):
# API_BASE_URL=http://192.168.1.10:3000/api/v1

# Production:
# API_BASE_URL=https://api.connectghin.com/api/v1
