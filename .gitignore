android/**/*.keystore
android/upload-keystore.jks
android/key.properties
android/**/GeneratedPluginRegistrant.java
**/*firebase-adminsdk*.json
**/*service-account*.json
*.pem
*.p12

# Release / sideload APKs (tool/build_release_apk.ps1 → dist/)
*.apk
*.aab
/dist/

